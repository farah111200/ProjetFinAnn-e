# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_pentest_db

# URL complète utilisée par SQLAlchemy (nom d'hôte "db" = nom du service Docker)
DATABASE_URL=postgresql://postgres:changeme@db:5432/ai_pentest_db
# OWASP ZAP (nom d'hôte "zap" = nom du service Docker)
ZAP_API_URL=http://zap:8080

# Où exécuter Nmap/Nuclei : "local" (dans le conteneur backend) ou "kali"
# (envoyé par SSH à ta VM Kali, qui exécute vraiment les outils)
SCAN_MODE=kali
KALI_HOST=ip_de_ta_vm_kali
KALI_SSH_PORT=22
KALI_SSH_USER=kali
KALI_SSH_PASSWORD=kali


# Fournisseur IA pour l'analyse des vulnérabilités :  "ollama" (gratuit,
# local) ou "openrouter" (gratuit, service externe, plusieurs modèles au choix)
AI_PROVIDER=ollama
OLLAMA_API_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# OpenRouter (https://openrouter.ai/keys) — modèle :free au choix, la liste
# disponible change régulièrement, vérifie suropenrouter.ai/models?max_price=0
OPENROUTER_API_KEY=ta_cle_api_ici
OPENROUTER_MODEL=nvidia/nemotron-3-ultra:free

# Sécurité JWT
SECRET_KEY=change_moi_avec_une_vraie_cle_secrete
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Compte admin créé automatiquement au premier démarrage
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=changeme123